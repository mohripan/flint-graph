# Settings for the local Studio launcher:
#   uv run python tools/narrative/studio.py
# Copy this file to studio.local.env at the repository root (git ignores it) and
# fill in the blanks. It holds credentials, so never commit or paste it.
#
# STUDIO_* lines configure the launcher. FLINT_GRAPH_* lines are the app's own
# settings (src/flint_graph/config.py); they go to the API and the workers only,
# never to the frontend or the playtest server.

# --- Launcher ---------------------------------------------------------------------
# Which processes to run, comma-separated:
#   api, worker (release builds), relay, assistant, image, voice, preview (playtests), frontend
STUDIO_SERVICES=api,worker,relay,assistant,image,voice,preview,frontend
STUDIO_API_PORT=8101
STUDIO_PREVIEW_PORT=5192
STUDIO_FRONTEND_PORT=5173
# Docker containers to start when they are stopped (PostgreSQL, MinIO, Temporal).
STUDIO_CONTAINERS=
# The built playtest player, made with tools/narrative/build_preview.py for
# --parent-origin http://localhost:<STUDIO_FRONTEND_PORT>. Rebuild it when the Godot
# runtime version changes; the launcher refuses a stale build.
STUDIO_PREVIEW_BUILD=notes/studio-preview

# --- App: local development mode ------------------------------------------------------
# "test" keeps every document-search provider offline and deterministic; the Studio's
# own model settings below are explicit.
FLINT_GRAPH_ENV=test
FLINT_GRAPH_AUTH_MODE=dev
FLINT_GRAPH_DEV_AUTH_SUBJECT=narrative-developer
FLINT_GRAPH_DEV_AUTH_NAME=Narrative developer
FLINT_GRAPH_OTEL_ENABLED=false

# --- Storage and workflows ------------------------------------------------------------
FLINT_GRAPH_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5432/DATABASE
FLINT_GRAPH_OBJECT_STORE_ENDPOINT_URL=http://127.0.0.1:9000
FLINT_GRAPH_OBJECT_STORE_BUCKET=
FLINT_GRAPH_OBJECT_STORE_ACCESS_KEY_ID=
FLINT_GRAPH_OBJECT_STORE_SECRET_ACCESS_KEY=
FLINT_GRAPH_OBJECT_STORE_FORCE_PATH_STYLE=true
FLINT_GRAPH_TEMPORAL_ADDRESS=127.0.0.1:7233
FLINT_GRAPH_TEMPORAL_NAMESPACE=default

# --- Release builds -------------------------------------------------------------------
FLINT_GRAPH_NARRATIVE_RELEASES_ENABLED=true
FLINT_GRAPH_NARRATIVE_TASK_QUEUE=narrative-build
# A private working folder for build children; keep it the same across restarts.
FLINT_GRAPH_NARRATIVE_BUILD_WORK_ROOT=notes/narrative-build-work
FLINT_GRAPH_NARRATIVE_RECOVERY_INTERVAL_SECONDS=5
# From the prepared builder (tools/narrative/prepare_builder.py, toolchain.json).
FLINT_GRAPH_NARRATIVE_RELEASE_BUILDER_IMAGE_DIGEST=
FLINT_GRAPH_NARRATIVE_RELEASE_TOOLCHAIN_SHA256=

# --- Story assistant (local Ollama) -----------------------------------------------------
FLINT_GRAPH_OLLAMA_BASE_URL=http://127.0.0.1:11434
FLINT_GRAPH_NARRATIVE_ASSISTANT_PROVIDER=ollama
FLINT_GRAPH_NARRATIVE_ASSISTANT_OLLAMA_MODEL=
FLINT_GRAPH_NARRATIVE_ASSISTANT_TASK_QUEUE=narrative-assistant

# --- Image generation (local GPU) -------------------------------------------------------
FLINT_GRAPH_NARRATIVE_IMAGE_GENERATION_ENABLED=true
FLINT_GRAPH_NARRATIVE_IMAGE_TASK_QUEUE=narrative-image
FLINT_GRAPH_NARRATIVE_IMAGE_RUNTIME_DIR=C:/path/to/flint-graph/runtimes/imagegen
FLINT_GRAPH_NARRATIVE_IMAGE_MODEL_DIR=C:/path/to/models/animagine-xl-4.0
FLINT_GRAPH_NARRATIVE_IMAGE_MODEL_MANIFEST_SHA256=
FLINT_GRAPH_NARRATIVE_IMAGE_CUTOUT_MODEL_DIR=C:/path/to/models/anime-seg
FLINT_GRAPH_NARRATIVE_IMAGE_CUTOUT_MANIFEST_SHA256=
# Lets the image worker ask Ollama to unload the assistant model when the GPU is full.
FLINT_GRAPH_NARRATIVE_IMAGE_RELEASE_OLLAMA_MODEL=
# Optional: your own copy of the image content policy (blocked words, safety tags).
# FLINT_GRAPH_NARRATIVE_IMAGE_CONTENT_POLICY=C:/path/to/image_content_policy.toml

# --- Voice generation (local GPU with CPU fallback, Kokoro-82M; ADR 0043) ----------------
# Install the child once: uv sync --frozen in runtimes/voicegen. The manifest pin is the
# SHA-256 of the model folder's flintgraph-download.json.
FLINT_GRAPH_NARRATIVE_VOICE_GENERATION_ENABLED=true
FLINT_GRAPH_NARRATIVE_VOICE_TASK_QUEUE=narrative-voice
FLINT_GRAPH_NARRATIVE_VOICE_RUNTIME_DIR=C:/path/to/flint-graph/runtimes/voicegen
FLINT_GRAPH_NARRATIVE_VOICE_MODEL_DIR=C:/path/to/models/kokoro-82m
FLINT_GRAPH_NARRATIVE_VOICE_MODEL_MANIFEST_SHA256=
# auto: the GPU when it has about 1 GiB free, else the CPU. Set cpu to keep the GPU free.
FLINT_GRAPH_NARRATIVE_VOICE_DEVICE=auto
