FLINT_GRAPH_ENV=local
FLINT_GRAPH_LOG_LEVEL=INFO
FLINT_GRAPH_PUBLIC_BASE_URL=
FLINT_GRAPH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FLINT_GRAPH_TRUSTED_HOSTS=localhost,127.0.0.1,testserver,test
FLINT_GRAPH_REQUIRE_TLS=false
FLINT_GRAPH_MAX_UPLOAD_BYTES=10485760
FLINT_GRAPH_MAX_URL_INTAKE_BYTES=10485760
FLINT_GRAPH_ALLOW_PRIVATE_URL_INTAKE=true
FLINT_GRAPH_RATE_LIMIT_ENABLED=false
FLINT_GRAPH_RATE_LIMIT_BACKEND=memory
FLINT_GRAPH_ALLOW_IN_MEMORY_RATE_LIMIT=false
FLINT_GRAPH_RATE_LIMIT_REQUESTS=60
FLINT_GRAPH_RATE_LIMIT_WINDOW_SECONDS=60
FLINT_GRAPH_DATABASE_URL=postgresql+asyncpg://flint_graph:flint_graph@localhost:5432/flint_graph
FLINT_GRAPH_TEMPORAL_ADDRESS=localhost:7233
FLINT_GRAPH_TEMPORAL_NAMESPACE=default
FLINT_GRAPH_TEMPORAL_TASK_QUEUE=ingestion
FLINT_GRAPH_TEMPORAL_WORKFLOW_NAME=IngestDocumentWorkflow
FLINT_GRAPH_NEO4J_URI=bolt://localhost:7687
FLINT_GRAPH_NEO4J_USER=neo4j
FLINT_GRAPH_NEO4J_PASSWORD=flintgraphpassword
FLINT_GRAPH_NEO4J_DATABASE=neo4j
FLINT_GRAPH_OBJECT_STORE_PROVIDER=s3
FLINT_GRAPH_OBJECT_STORE_BUCKET=flint-graph
FLINT_GRAPH_OBJECT_STORE_ENDPOINT_URL=http://localhost:9000
FLINT_GRAPH_OBJECT_STORE_REGION=us-east-1
FLINT_GRAPH_OBJECT_STORE_ACCESS_KEY_ID=flint_graph
FLINT_GRAPH_OBJECT_STORE_SECRET_ACCESS_KEY=flint-graph-secret
FLINT_GRAPH_OBJECT_STORE_FORCE_PATH_STYLE=true
FLINT_GRAPH_INTAKE_MAX_SOURCE_BYTES=10485760
FLINT_GRAPH_INTAKE_URL_TIMEOUT_SECONDS=10
FLINT_GRAPH_PARSER_TIMEOUT_SECONDS=30
FLINT_GRAPH_PARSER_MAX_RAW_BYTES=10485760
FLINT_GRAPH_PARSER_MAX_NORMALIZED_BYTES=5242880
FLINT_GRAPH_PARSER_MAX_ELEMENTS=10000
FLINT_GRAPH_CHUNKING_MAX_CHUNK_CHARS=1200
FLINT_GRAPH_CHUNKING_OVERLAP_CHARS=120
FLINT_GRAPH_OTEL_ENABLED=true
FLINT_GRAPH_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
FLINT_GRAPH_OTEL_EXPORTER_OTLP_INSECURE=true
FLINT_GRAPH_EXTRACTION_ENABLED=true
FLINT_GRAPH_EXTRACTION_MODE=optional
FLINT_GRAPH_LLM_PROVIDER=ollama
FLINT_GRAPH_OLLAMA_BASE_URL=http://host.docker.internal:11434
FLINT_GRAPH_OLLAMA_MODEL=gemma3:1b
FLINT_GRAPH_EXTRACTION_TIMEOUT_SECONDS=60
FLINT_GRAPH_INDEXING_MODE=optional
FLINT_GRAPH_EMBEDDING_PROVIDER=deterministic
FLINT_GRAPH_EMBEDDING_MODEL=deterministic-test
FLINT_GRAPH_EMBEDDING_DIMENSIONS=384
FLINT_GRAPH_EMBEDDING_BATCH_SIZE=32
FLINT_GRAPH_EMBEDDING_TIMEOUT_SECONDS=60
FLINT_GRAPH_EMBEDDING_OLLAMA_BASE_URL=http://host.docker.internal:11434
FLINT_GRAPH_EMBEDDING_OPENAI_BASE_URL=https://api.openai.com
FLINT_GRAPH_EMBEDDING_OPENAI_API_KEY=
FLINT_GRAPH_ACTIVE_RETRIEVAL_INDEX_VERSION_ID=
FLINT_GRAPH_INDEX_BACKFILL_BATCH_SIZE=25
FLINT_GRAPH_OPENSEARCH_URL=http://localhost:9200
# Provide a key and unset/override the providers below to exercise the real-model defaults.
FLINT_GRAPH_ANTHROPIC_API_KEY=
FLINT_GRAPH_ANTHROPIC_ANSWER_MODEL=claude-opus-4-8
FLINT_GRAPH_ANTHROPIC_SUPPORT_MODEL=claude-opus-4-8
FLINT_GRAPH_ANTHROPIC_EFFORT=medium
# No-cost local defaults for this sample file. The application defaults still resolve
# non-test environments to Anthropic when these are unset.
FLINT_GRAPH_QUERY_ANSWER_PROVIDER=deterministic
FLINT_GRAPH_QUERY_SUPPORT_PROVIDER=deterministic
FLINT_GRAPH_QUERY_ANSWER_MODEL=llama3.2
FLINT_GRAPH_QUERY_SUPPORT_MODEL=llama3.2
FLINT_GRAPH_QUERY_ANSWER_TIMEOUT_SECONDS=180
FLINT_GRAPH_QUERY_ANSWER_MAX_TOKENS=1024
# Explicit request context, independent of host Ollama service defaults.
# Must cover packed context + output + 2048 estimated prompt-overhead reserve.
FLINT_GRAPH_QUERY_OLLAMA_CONTEXT_TOKENS=8192
FLINT_GRAPH_QUERY_CONTEXT_TOKEN_BUDGET=4000
FLINT_GRAPH_QUERY_MAX_CONTEXT_RECORDS=25

# Milestone 10 local Ollama path. Pull models first, then override the deterministic
# values above:
#   ollama pull nomic-embed-text
#   ollama pull llama3.2
#   FLINT_GRAPH_EMBEDDING_PROVIDER=ollama
#   FLINT_GRAPH_EMBEDDING_MODEL=nomic-embed-text
#   FLINT_GRAPH_EMBEDDING_DIMENSIONS=768
#   FLINT_GRAPH_QUERY_ANSWER_PROVIDER=ollama
#   FLINT_GRAPH_QUERY_SUPPORT_PROVIDER=ollama
#   FLINT_GRAPH_QUERY_ANSWER_MODEL=llama3.2
#   FLINT_GRAPH_QUERY_SUPPORT_MODEL=llama3.2
# On CPU-constrained machines, use a smaller installed Ollama model and a smaller
# context pack for smoke tests:
#   FLINT_GRAPH_QUERY_ANSWER_MODEL=gemma3:270m
#   FLINT_GRAPH_QUERY_SUPPORT_MODEL=gemma3:270m
#   FLINT_GRAPH_QUERY_ANSWER_MAX_TOKENS=160
#   FLINT_GRAPH_QUERY_CONTEXT_TOKEN_BUDGET=350
#   FLINT_GRAPH_QUERY_MAX_CONTEXT_RECORDS=1
