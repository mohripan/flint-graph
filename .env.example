ATLAS_ENV=local
ATLAS_LOG_LEVEL=INFO
ATLAS_DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas
ATLAS_TEMPORAL_ADDRESS=localhost:7233
ATLAS_TEMPORAL_NAMESPACE=default
ATLAS_TEMPORAL_TASK_QUEUE=ingestion
ATLAS_TEMPORAL_WORKFLOW_NAME=IngestDocumentWorkflow
ATLAS_OBJECT_STORE_PROVIDER=s3
ATLAS_OBJECT_STORE_BUCKET=atlas-rag
ATLAS_OBJECT_STORE_ENDPOINT_URL=http://localhost:9000
ATLAS_OBJECT_STORE_REGION=us-east-1
ATLAS_OBJECT_STORE_ACCESS_KEY_ID=atlas
ATLAS_OBJECT_STORE_SECRET_ACCESS_KEY=atlas-secret
ATLAS_OBJECT_STORE_FORCE_PATH_STYLE=true
ATLAS_OTEL_ENABLED=true
ATLAS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ATLAS_OTEL_EXPORTER_OTLP_INSECURE=true
ATLAS_EXTRACTION_ENABLED=true
ATLAS_EXTRACTION_MODE=optional
ATLAS_LLM_PROVIDER=ollama
ATLAS_OLLAMA_BASE_URL=http://host.docker.internal:11434
ATLAS_OLLAMA_MODEL=gemma3:1b
