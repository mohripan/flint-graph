ATLAS_ENV=local
ATLAS_LOG_LEVEL=INFO
ATLAS_DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas
ATLAS_TEMPORAL_ADDRESS=localhost:7233
ATLAS_TEMPORAL_NAMESPACE=default
ATLAS_TEMPORAL_TASK_QUEUE=ingestion
ATLAS_TEMPORAL_WORKFLOW_NAME=IngestDocumentWorkflow
ATLAS_NEO4J_URI=bolt://localhost:7687
ATLAS_NEO4J_USER=neo4j
ATLAS_NEO4J_PASSWORD=atlaspassword
ATLAS_NEO4J_DATABASE=neo4j
ATLAS_OBJECT_STORE_PROVIDER=s3
ATLAS_OBJECT_STORE_BUCKET=atlas-rag
ATLAS_OBJECT_STORE_ENDPOINT_URL=http://localhost:9000
ATLAS_OBJECT_STORE_REGION=us-east-1
ATLAS_OBJECT_STORE_ACCESS_KEY_ID=atlas
ATLAS_OBJECT_STORE_SECRET_ACCESS_KEY=atlas-secret
ATLAS_OBJECT_STORE_FORCE_PATH_STYLE=true
ATLAS_INTAKE_MAX_SOURCE_BYTES=10485760
ATLAS_INTAKE_URL_TIMEOUT_SECONDS=10
ATLAS_PARSER_TIMEOUT_SECONDS=30
ATLAS_PARSER_MAX_RAW_BYTES=10485760
ATLAS_PARSER_MAX_NORMALIZED_BYTES=5242880
ATLAS_PARSER_MAX_ELEMENTS=10000
ATLAS_CHUNKING_MAX_CHUNK_CHARS=1200
ATLAS_CHUNKING_OVERLAP_CHARS=120
ATLAS_OTEL_ENABLED=true
ATLAS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ATLAS_OTEL_EXPORTER_OTLP_INSECURE=true
ATLAS_EXTRACTION_ENABLED=true
ATLAS_EXTRACTION_MODE=optional
ATLAS_LLM_PROVIDER=ollama
ATLAS_OLLAMA_BASE_URL=http://host.docker.internal:11434
ATLAS_OLLAMA_MODEL=gemma3:1b
ATLAS_EXTRACTION_TIMEOUT_SECONDS=60
ATLAS_INDEXING_MODE=optional
ATLAS_EMBEDDING_PROVIDER=deterministic
ATLAS_EMBEDDING_MODEL=deterministic-test
ATLAS_EMBEDDING_DIMENSIONS=384
ATLAS_EMBEDDING_BATCH_SIZE=32
ATLAS_EMBEDDING_TIMEOUT_SECONDS=60
ATLAS_EMBEDDING_OLLAMA_BASE_URL=http://host.docker.internal:11434
ATLAS_EMBEDDING_OPENAI_BASE_URL=https://api.openai.com
ATLAS_EMBEDDING_OPENAI_API_KEY=
ATLAS_ACTIVE_RETRIEVAL_INDEX_VERSION_ID=
ATLAS_INDEX_BACKFILL_BATCH_SIZE=25
ATLAS_OPENSEARCH_URL=http://localhost:9200
# Provide a key, or override the providers below to run without one.
ATLAS_ANTHROPIC_API_KEY=
ATLAS_ANTHROPIC_ANSWER_MODEL=claude-opus-4-8
ATLAS_ANTHROPIC_SUPPORT_MODEL=claude-opus-4-8
ATLAS_ANTHROPIC_EFFORT=medium
# To run locally without a key, uncomment:
# ATLAS_QUERY_ANSWER_PROVIDER=deterministic
# ATLAS_QUERY_SUPPORT_PROVIDER=deterministic