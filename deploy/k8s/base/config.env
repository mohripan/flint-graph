FLINT_GRAPH_ENV=production
FLINT_GRAPH_LOG_LEVEL=INFO
FLINT_GRAPH_REQUIRE_TLS=true
FLINT_GRAPH_RATE_LIMIT_ENABLED=true
FLINT_GRAPH_RATE_LIMIT_BACKEND=memory
FLINT_GRAPH_ALLOW_IN_MEMORY_RATE_LIMIT=true
FLINT_GRAPH_AUTH_MODE=oidc
FLINT_GRAPH_ACCESS_MODE=invite
FLINT_GRAPH_READINESS_REQUIRED_DEPENDENCIES=["postgres","object_store","temporal"]
FLINT_GRAPH_READINESS_OPTIONAL_DEPENDENCIES=[]
FLINT_GRAPH_TEMPORAL_ADDRESS=temporal:7233
FLINT_GRAPH_OBJECT_STORE_ENDPOINT_URL=http://minio:9000
FLINT_GRAPH_OBJECT_STORE_BUCKET=flint-graph
FLINT_GRAPH_OBJECT_STORE_FORCE_PATH_STYLE=true
FLINT_GRAPH_EMBEDDING_PROVIDER=deterministic
FLINT_GRAPH_QUERY_ANSWER_PROVIDER=deterministic
FLINT_GRAPH_QUERY_SUPPORT_PROVIDER=deterministic
FLINT_GRAPH_NARRATIVE_RELEASES_ENABLED=false
FLINT_GRAPH_NARRATIVE_ASSISTANT_PROVIDER=ollama
FLINT_GRAPH_NARRATIVE_ASSISTANT_TURN_DEADLINE_SECONDS=420
FLINT_GRAPH_NARRATIVE_ASSISTANT_OLLAMA_MODEL=igorls/gemma-4-12B-it-qat-q4_0-unquantized-heretic:latest
FLINT_GRAPH_NARRATIVE_ASSISTANT_VISION_MODEL=lfm3-vl:2b
FLINT_GRAPH_NARRATIVE_IMAGE_GENERATION_ENABLED=true
FLINT_GRAPH_NARRATIVE_IMAGE_JOB_DEADLINE_SECONDS=900
FLINT_GRAPH_NARRATIVE_IMAGE_RUNTIME_DIR=/app/runtimes/imagegen
FLINT_GRAPH_NARRATIVE_IMAGE_MODEL_DIR=/models/animagine-xl-4.0
