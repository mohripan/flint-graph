{
  "title": "FlintGraph Operations",
  "uid": "flint-graph-operations",
  "tags": [
    "flint-graph",
    "platform",
    "milestone-24"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "FlintGraph metrics",
          "value": "flint-graph-metrics"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "API",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate by status class",
      "description": "Requests per second, bucketed by status class.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_class) (rate(flint_graph_http_server_request_duration_milliseconds_count[5m]))",
          "legendFormat": "{{http_response_status_class}}",
          "editorMode": "code"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request latency p50/p95/p99",
      "description": "Latency percentiles across all routes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(flint_graph_http_server_request_duration_milliseconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(flint_graph_http_server_request_duration_milliseconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "editorMode": "code"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(flint_graph_http_server_request_duration_milliseconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "editorMode": "code"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
