# Player terms in NOTICES (ADR 0044, runtime 0.7.0): the same rules as the Python
# reference, the preview validator and the Studio. Terms sit between two fixed marker
# lines after the generated asset-notices marker, where creator text cannot reach.
extends RefCounted

const NOTICE_MARKER := "=== Asset notices (generated by FlintGraph; edits below this line are replaced) ==="
const TERMS_BEGIN := "=== Player terms (shown once to players by the game) ==="
const TERMS_END := "=== End of player terms ==="
const TERMS_LIMIT := 65536


static func parse(notices: String) -> Dictionary:
	var lines := notices.split("\n")
	var marker := lines.find(NOTICE_MARKER)
	if marker < 0:
		return {"ok": true, "terms": null}
	var generated := lines.slice(marker + 1)
	var begin := generated.find(TERMS_BEGIN)
	if begin < 0:
		return {"ok": generated.find(TERMS_END) < 0, "terms": null}
	var rest := generated.slice(begin + 1)
	var end := rest.find(TERMS_END)
	if end < 0 or rest.find(TERMS_BEGIN) >= 0:
		return {"ok": false, "terms": null}
	var after := rest.slice(end + 1)
	if after.find(TERMS_END) >= 0:
		return {"ok": false, "terms": null}
	for line: String in after:
		if line.strip_edges() != "":
			return {"ok": false, "terms": null}
	var body := "\n".join(rest.slice(0, end))
	while body.begins_with("\n"):
		body = body.substr(1)
	while body.ends_with("\n"):
		body = body.substr(0, body.length() - 1)
	if body.strip_edges() == "" or body.to_utf8_buffer().size() > TERMS_LIMIT:
		return {"ok": false, "terms": null}
	return {"ok": true, "terms": body}
