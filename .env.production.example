FLINT_GRAPH_ENV=production
FLINT_GRAPH_LOG_LEVEL=INFO

# Public exposure boundary.
FLINT_GRAPH_PUBLIC_BASE_URL=https://api.example.com
FLINT_GRAPH_ALLOWED_ORIGINS=https://app.example.com
FLINT_GRAPH_TRUSTED_HOSTS=api.example.com
FLINT_GRAPH_REQUIRE_TLS=true
FLINT_GRAPH_MAX_UPLOAD_BYTES=10485760
FLINT_GRAPH_MAX_URL_INTAKE_BYTES=10485760
FLINT_GRAPH_ALLOW_PRIVATE_URL_INTAKE=false
FLINT_GRAPH_RATE_LIMIT_ENABLED=true
FLINT_GRAPH_RATE_LIMIT_BACKEND=memory
# Use only for a single-process controlled deployment. Replace with a distributed
# limiter before running multiple API replicas.
FLINT_GRAPH_ALLOW_IN_MEMORY_RATE_LIMIT=true
FLINT_GRAPH_RATE_LIMIT_REQUESTS=60
FLINT_GRAPH_RATE_LIMIT_WINDOW_SECONDS=60

# Authentication.
FLINT_GRAPH_AUTH_MODE=oidc
FLINT_GRAPH_OIDC_ISSUER=https://idp.example.com/realms/flintgraph
FLINT_GRAPH_OIDC_AUDIENCE=flintgraph-api
FLINT_GRAPH_OIDC_JWKS_URL=

# Backing stores. Replace every placeholder.
FLINT_GRAPH_DATABASE_URL=postgresql+asyncpg://flint_graph:${POSTGRES_PASSWORD}@postgres:5432/flint_graph
FLINT_GRAPH_TEMPORAL_ADDRESS=temporal:7233
FLINT_GRAPH_NEO4J_URI=bolt://neo4j:7687
FLINT_GRAPH_NEO4J_USER=neo4j
FLINT_GRAPH_NEO4J_PASSWORD=${NEO4J_PASSWORD}
FLINT_GRAPH_OBJECT_STORE_PROVIDER=s3
FLINT_GRAPH_OBJECT_STORE_BUCKET=flint-graph-prod
FLINT_GRAPH_OBJECT_STORE_ENDPOINT_URL=https://s3.example.com
FLINT_GRAPH_OBJECT_STORE_REGION=us-east-1
FLINT_GRAPH_OBJECT_STORE_ACCESS_KEY_ID=${OBJECT_STORE_ACCESS_KEY_ID}
FLINT_GRAPH_OBJECT_STORE_SECRET_ACCESS_KEY=${OBJECT_STORE_SECRET_ACCESS_KEY}
FLINT_GRAPH_OBJECT_STORE_FORCE_PATH_STYLE=false
FLINT_GRAPH_OPENSEARCH_URL=https://opensearch.example.com

# Model providers.
FLINT_GRAPH_EMBEDDING_PROVIDER=openai_compatible
FLINT_GRAPH_EMBEDDING_OPENAI_BASE_URL=https://api.openai.com
FLINT_GRAPH_EMBEDDING_OPENAI_API_KEY=${EMBEDDING_OPENAI_API_KEY}
FLINT_GRAPH_QUERY_ANSWER_PROVIDER=anthropic
FLINT_GRAPH_QUERY_SUPPORT_PROVIDER=anthropic
FLINT_GRAPH_ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
